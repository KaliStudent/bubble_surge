{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bubble-surge",
	"main": "cloudflare/worker.mjs",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/healthz"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bubble-surge-db",
			"database_id": "91c01678-74c6-46af-a58a-c6159e4979a4",
			"migrations_dir": "cloudflare/migrations"
		}
	],
	"vars": {
		"SURGE_PUBLIC_ORIGIN": "https://bubbles.tunlz.dev",
		"SURGE_SUPPORT_CONTACT": "@bubble_surge_support",
		"SURGE_PAYMENTS_ENABLED": "false",
		"TELEGRAM_TEST_MODE": "false"
	},
	"triggers": {
		"crons": [
			"17 * * * *"
		]
	}
}
