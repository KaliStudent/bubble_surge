@font-face {
  font-family: "MyCustomFont";
  src: url("s://buf.wtf/wp-content/besides.woff") format("woff");
  font-weight: normal;
  font-style: normal;
}

.card {
  position: absolute;
  width: 350px;
  height: 500px;
  background: #020617;
  border: solid black 10px;
  border-top-left-radius:;
  border-top-right-radius:;
  border-bottom-left-radius: 22px;
  border-bottom-right-radius: 22px;
  background: linear-gradient(130deg, #020617, #1e3a8a, #60a5fa);
}

.settings-btn {
  float: right;
  position: relative;
  height: 50px;
  width: 50px;
  left: 40px;
  background: transparent;
  border: none;
  outline: none;
  z-index: 10;
}

.game-btn {
  left: 40px;
  bottom: 60px;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 260px;
  height: 80px;
  border: none;
  cursor: pointer;
  clip-path: polygon(
    35px 0%,
    calc(100% - 35px) 0%,
    100% 50%,
    calc(100% - 35px) 100%,
    35px 100%,
    0% 50%
  );
  background: linear-gradient(180deg, #ffff00 0%, #ffd000 65%, #cca000 100%);
  filter: drop-shadow(0 6px 0 #8a6c00);
  transition:
    transform 0.1s ease,
    filter 0.1s ease;
  z-index: 3;
}

.game-btn::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: rgba(0, 0, 0, 0.08);
  pointer-events: none;
}

.game-btn:active {
  transform: translateY(3px);
  filter: drop-shadow(0 3px 0 #8a6c00);
}

.btn-text-p {
  position: relative;
  z-index: 1;
  font-family: Helvetica;
  font-size: 4rem;
  font-weight: 70;
  font-stretch: wider;
  letter-spacing: 1px;
  color: #ffffff;

  text-shadow:
    3px 4px 0px #000000,
    -1px -1px 0px #000000;
  rotate: 2deg;
}
.btn-text-l {
  position: relative;
  z-index: 1;
  font-family: Helvetica;
  font-size: 4rem;
  font-weight: 70;
  font-stretch: wider;
  letter-spacing: 1px;
  color: #ffffff;

  text-shadow:
    3px 4px 0px #000000,
    -1px -1px 0px #000000;
  rotate: -1deg;
}
.btn-text-a {
  position: relative;
  z-index: 1;
  font-family: Helvetica;
  font-size: 4rem;
  font-weight: 70;
  font-stretch: wider;
  letter-spacing: 1px;
  color: #ffffff;

  text-shadow:
    3px 4px 0px #000000,
    -1px -1px 0px #000000;
  rotate: 1deg;
}
.btn-text-y {
  position: relative;
  z-index: 1;
  font-family: Helvetica;
  font-size: 4rem;
  font-weight: 70;
  font-stretch: wider;
  letter-spacing: 1px;
  color: #ffffff;

  text-shadow:
    3px 4px 0px #000000,
    -1px -1px 0px #000000;
  rotate: -2deg;
}

.svg {
